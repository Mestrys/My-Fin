# Copie para .env e ajuste para o seu ambiente.
#
# DATABASE_URL: usada pelo Prisma Client em runtime (Server Actions, API
# routes). Em produção, aponte para o endpoint com CONNECTION POOLING do
# provedor (Supabase: porta 6543 + `?pgbouncer=true`; Neon: endpoint
# "-pooler"). Essencial em ambientes serverless (Netlify Functions), onde
# cada invocação pode abrir uma conexão nova.
DATABASE_URL="postgresql://user:password@localhost:5432/myfin?schema=public"

# DIRECT_URL: conexão direta (sem pooler), usada apenas pelo Prisma Migrate
# (DDL/migrations não funcionam de forma confiável através de um
# connection pooler em modo transaction).
DIRECT_URL="postgresql://user:password@localhost:5432/myfin?schema=public"

# --- InterApiAdapter (Banking PJ / mTLS) ---
INTER_CLIENT_ID=""
INTER_CLIENT_SECRET=""
INTER_CERT_BASE64=""
INTER_KEY_BASE64=""
INTER_ACCOUNT_NUMBER=""
# Opcionais (defaults da API Banking PJ):
# INTER_TOKEN_URL="https://cdpj.partners.bancointer.com.br/oauth/v2/token"
# INTER_EXTRATO_URL="https://cdpj.partners.bancointer.com.br/banking/v2/extrato"

# --- Acesso (opcional, recomendado em deploy público) ---
# Se definido, o middleware exige cookie/Bearer com este valor.
# APP_ACCESS_TOKEN=""
